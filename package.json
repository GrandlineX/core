{
  "name": "@grandlinex/core",
  "version": "3.0.0-alpha.9",
  "description": "Core module",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./dev": {
      "import": {
        "types": "./dist/dev/index.d.mts",
        "default": "./dist/dev/index.mjs"
      },
      "require": {
        "types": "./dist/dev/index.d.cts",
        "default": "./dist/dev/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "run": "tsx src/dev/run.ts",
    "lint": "eslint src",
    "test": "vitest",
    "test-coverage": "vitest run --coverage",
    "pack": "eslint && npm run build && npm pack",
    "makeDocs": "typedoc"
  },
  "keywords": [
    "typescript",
    "framework",
    "server",
    "backend",
    "orm"
  ],
  "author": {
    "name": "Elschnagoo"
  },
  "license": "BSD-3-Clause",
  "dependencies": {
    "reflect-metadata": "0.2.2"
  },
  "peerDependencies": { "vitest": ">=4.1.10" },
  "peerDependenciesMeta": { "vitest": { "optional": true } },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "8.57.1",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-airbnb-typescript": "18.0.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-jsx-a11y": "6.9.0",
    "eslint-plugin-prettier": "5.2.1",
    "prettier": "3.5.3",
    "tsx": "4.23.12",
    "vitest": "4.1.10",
    "tsdown": "0.22.14",
    "typedoc": "0.28.20",
    "typescript": "6.0.3"
  },
  "homepage": "https://www.grandlinex.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/GrandlineX/core.git"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
